{
  "uid": "servidor",
  "title": "Servidor",
  "description": "Uso de recursos y logs de los servicios.",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU usada",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 2,
      "title": "RAM usada",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "RAM"
        }
      ]
    },
    {
      "id": 3,
      "title": "Disco usado (/)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
          "legendFormat": "Disco"
        }
      ]
    },
    {
      "id": 4,
      "title": "Errores en los servicios",
      "description": "Líneas del journal que mencionan errores.",
      "type": "logs",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{job=\"journal\"} |~ \"(?i)error|failed|fatal\" !~ \"level=(debug|info)\"" }
      ]
    },
    {
      "id": 5,
      "title": "Logs de los contenedores",
      "type": "logs",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{job=\"journal\", contenedor=~\".+\"}" }
      ]
    },
    {
      "id": 6,
      "title": "Peticiones web (Caddy)",
      "type": "logs",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{job=\"caddy\"}" }
      ]
    },
    {
      "id": 7,
      "title": "Conexiones a PostgreSQL",
      "type": "logs",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 35 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{job=\"postgres\"}" }
      ]
    },
    {
      "id": 8,
      "title": "Resultado de los backups",
      "type": "logs",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{job=\"journal\", servicio=\"backup-servidor.service\"}" }
      ]
    }
  ]
}
