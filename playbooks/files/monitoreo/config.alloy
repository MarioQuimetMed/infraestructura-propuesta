// Gestionado por Ansible. Los cambios hechos a mano se perderán.
//
// Alloy recoge los logs y los envía a Loki.
// Cada log lleva etiquetas (job, programa...) que sirven para filtrar en Grafana.

// --- Destino -----------------------------------------------------------------

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}

// --- Journal del sistema -----------------------------------------------------
// Aquí están SSH, sudo, los servicios y los contenedores de Docker.

loki.relabel "journal" {
  forward_to = []

  // Nombre del programa, por ejemplo sshd o sudo
  rule {
    source_labels = ["__journal__comm"]
    target_label  = "programa"
  }

  // Servicio de systemd, por ejemplo backup-servidor.service
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "servicio"
  }

  // Nombre del contenedor, solo en los logs que vienen de Docker
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "contenedor"
  }
}

loki.source.journal "sistema" {
  forward_to    = [loki.write.local.receiver]
  relabel_rules = loki.relabel.journal.rules
  labels        = { job = "journal" }
}

// --- Archivos de log ---------------------------------------------------------

local.file_match "archivos" {
  path_targets = [
    { __path__ = "/var/log/laurel/audit.log", job = "auditoria" },
    { __path__ = "/var/log/caddy/*.log", job = "caddy" },
    { __path__ = "/var/log/postgresql/*.log", job = "postgres" },
  ]
}

loki.source.file "archivos" {
  targets    = local.file_match.archivos.targets
  forward_to = [loki.write.local.receiver]
}
